# Copy this file to .env and fill in the values.

# ── Broker ────────────────────────────────────────────────────────────────────
RABBITMQ_USER=figs_user
RABBITMQ_PASS=figs_password

# ── Database ──────────────────────────────────────────────────────────────────
# POSTGRES_USER and POSTGRES_DB default to 'postgres' and 'market_signals'
POSTGRES_PASSWORD=change_me

# ── External API keys ─────────────────────────────────────────────────────────
GROQ_API_KEY=
FRED_API_KEY=
ETHERSCAN_API_KEY=
GITHUB_TOKEN=
OWLRACLE_API_KEY=
